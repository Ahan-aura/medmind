# MEDMIND AI 2.0 - Environment Configuration
# Copy this file to .env and customize as necessary

# Database URL: Supports SQLite out-of-the-box or PostgreSQL
DATABASE_URL=sqlite:///./medmind.db
# DATABASE_URL=postgresql+psycopg://medmind:medmind@localhost:5432/medmind

# JWT Secret Key for Session Authentication (minimum 32 characters)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Allowed Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# LLM API Configuration (Anthropic Claude)
# If omitted or offline, the platform automatically utilizes faculty-reviewed grounded feedback!
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# Tutor Configuration
TUTOR_TIMEOUT_SECONDS=20
TUTOR_MODE=auto
