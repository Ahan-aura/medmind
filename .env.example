# MEDMIND AI 2.0 - Environment Configuration
# Copy this file to .env and customize as necessary

# Database URL: Supports SQLite out-of-the-box or PostgreSQL with pgvector
DATABASE_URL=sqlite:///./medmind.db
# DATABASE_URL=postgresql+psycopg://medmind:medmind@localhost:5432/medmind

# JWT Secret Key for Session Authentication
JWT_SECRET=medmind-super-secure-jwt-secret-key-yukthi-2026

# Allowed Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Optional LLM API Keys (Anthropic Claude or Google Gemini)
# If omitted or offline, the platform automatically utilizes faculty-reviewed grounded feedback!
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Tutor Configuration
TUTOR_TIMEOUT_SECONDS=20
TUTOR_MODE=auto
